# Entorno virtual de Python (lo crea setup_entorno_virtual.bat)
.venv/
venv/
env/

# Configuración local del editor
# .vscode/settings.json lo genera setup_entorno_virtual.bat en cada máquina
.vscode/
.idea/

# Modelos entrenados (se regeneran con notebooks/03_modelos.ipynb o python src/models.py)
models/

# Archivos de Python
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints/

# Archivos temporales de Excel / Office (se crean al abrir un archivo)
~$*
.~lock.*

# Logs y cachés
*.log
.cache/

# Variables de entorno y secretos
.env
.env.*

# Archivos temporales del sistema
.DS_Store
Thumbs.db
desktop.ini
